<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Android 13 (API 33) 及以上的图片读取权限 -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- 读取 Live Photo 同目录的同名视频（.mov/.mp4），Android 13+ 必需 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 14 (API 34) 及以上的"仅选中照片"部分授权 -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />
    <!-- Android 12 及以下 -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- 读取原图 EXIF 中的 GPS 信息 -->
    <uses-permission android:name="android.permission.ACCESS_MEDIA_LOCATION" />
    <!-- 媒体管理权限：授予后，删除/移入回收站/重命名无需每次弹系统确认框 -->
    <uses-permission android:name="android.permission.MANAGE_MEDIA" />
    <!-- 反查拍摄地址（可选，无网络时自动降级为只显示经纬度） -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".PhotoOApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.PhotoO"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|smallestScreenSize"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.PhotoO">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
